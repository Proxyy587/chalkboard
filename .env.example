# Video worker (Python) — copy to `.env` on the VPS. Never commit real secrets.

OPENROUTER_API_KEY=

# Platform R2 (used only when x-api-key == CLARITY_API_KEY)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Prefer host-only endpoint (no /bucket path):
# AWS_ENDPOINT_URL_S3=https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT_URL_S3=
# Or set R2_ENDPOINT_URL=

# Owner / master API key — platform storage + open demo via Next proxy
CLARITY_API_KEY=

# Shared with Next.js for chalk_* validation + encrypted user storage + quotas
DATABASE_URL=
SECRET_ENCRYPTION_KEY=

# Free / paid API caps (chalk_* keys)
FREE_DAILY_VIDEO_LIMIT=3
HOBBY_MONTHLY_VIDEO_LIMIT=40
PRO_MONTHLY_VIDEO_LIMIT=80

CLARITY_ENV=local
# CLARITY_ENV=vps
ALLOWED_ORIGINS=*
