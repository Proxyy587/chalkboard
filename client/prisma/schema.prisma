generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth core models ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  apiKeys             ApiKey[]
  storageIntegrations StorageIntegration[]
  threads             Thread[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ─── Chalkboard API keys & storage ────────────────────────────────────────────

model ApiKey {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  prefix  String
  keyHash String @unique @map("key_hash")

  type        ApiKeyType @default(SECRET)
  environment ApiKeyEnv  @default(LIVE)
  version     Int        @default(1)

  plan        ApiKeyPlan @default(FREE)
  credits     Decimal    @default(0) @db.Decimal(12, 6)
  creditLimit Decimal?   @map("credit_limit") @db.Decimal(12, 6)

  usageCount Int       @default(0) @map("usage_count")
  lastUsedAt DateTime? @map("last_used_at")
  lastUsedIp String?   @map("last_used_ip")

  rateLimit  Int?      @map("rate_limit")
  allowedIps String[]  @default([]) @map("allowed_ips")
  scopes     String[]  @default(["video:generate", "video:read"])
  expiresAt  DateTime? @map("expires_at")

  isActive  Boolean   @default(true) @map("is_active")
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usageLogs ApiKeyUsageLog[]

  @@index([keyHash])
  @@index([userId])
  @@index([prefix])
  @@map("api_keys")
}

model ApiKeyUsageLog {
  id       String @id @default(cuid())
  apiKeyId String @map("api_key_id")
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  endpoint     String
  method       String
  creditsUsed  Decimal @default(0) @map("credits_used") @db.Decimal(12, 6)
  model        String?
  inputTokens  Int?    @map("input_tokens")
  outputTokens Int?    @map("output_tokens")
  statusCode   Int     @map("status_code")
  durationMs   Int     @map("duration_ms")
  ipAddress    String? @map("ip_address")
  userAgent    String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_key_usage_logs")
}

model StorageIntegration {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  provider StorageProvider

  encryptedConfig String @map("encrypted_config")

  bucketName String  @map("bucket_name")
  region     String?
  publicUrl  String? @map("public_url")

  isActive   Boolean   @default(true) @map("is_active")
  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at")
  lastUsedAt DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider, bucketName])
  @@index([userId])
  @@map("storage_integrations")
}

enum ApiKeyType {
  SECRET
  PUBLIC
}

enum ApiKeyEnv {
  LIVE
  TEST
}

enum ApiKeyPlan {
  FREE
  STUDENT
  PRO
  CREATOR
  ENTERPRISE
  OWNER
}

enum StorageProvider {
  S3
  R2
  UPLOADTHING
  BACKBLAZE
  MINIO
  CUSTOM_S3
}

// ─── Lecture threads (synced from demo UI when signed in) ─────────────────────

model Thread {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  model    String  @default("deepseek/deepseek-v3.2")
  duration Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ThreadMessage[]
  videos   ThreadVideo[]

  @@index([userId, updatedAt])
  @@map("threads")
}

model ThreadMessage {
  id       String @id @default(cuid())
  threadId String @map("thread_id")
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([threadId])
  @@map("thread_messages")
}

model ThreadVideo {
  id       String @id @default(cuid())
  threadId String @map("thread_id")
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  title    String
  status   String  @default("queued")
  jobId    String? @map("job_id")
  videoUrl String? @map("video_url") @db.Text
  error    String? @db.Text
  cached   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([threadId, createdAt])
  @@index([jobId])
  @@map("thread_videos")
}

// ─── Generation quotas (guest IP + free daily limits) ─────────────────────────

model GenerationQuota {
  id      String @id @default(cuid())
  /// e.g. ip:<sha256> | user:<id> | key:<apiKeyId>
  subject String
  /// "lifetime" for guests, or YYYY-MM-DD for daily caps
  window  String
  count   Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subject, window])
  @@index([subject])
  @@map("generation_quotas")
}
